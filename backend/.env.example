# Server
NODE_ENV=development
PORT=4000

# CORS — comma-separated list of allowed origins. Required (no wildcard) in production.
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/renisinfra?schema=public"

# Auth (set a strong secret in production)
JWT_ACCESS_SECRET="dev-access-secret-change-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME="renis_refresh"
# COOKIE_DOMAIN=

# Media storage (local disk)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15
# PUBLIC_ASSET_BASE_URL=http://localhost:4000
